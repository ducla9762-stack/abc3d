<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Generated by external\qtgamepadlegacy\build-qt611.ps1.
    Keep this dependency beside the project rather than modifying the Qt kit.
  -->
  <PropertyGroup>
    <QtGamepadLegacyRoot>$(MSBuildThisFileDirectory)external\qtgamepadlegacy\install\$(Configuration)</QtGamepadLegacyRoot>
    <QtGamepadLegacyBuildScript>$(MSBuildThisFileDirectory)tools\build-qtgamepadlegacy.ps1</QtGamepadLegacyBuildScript>
    <QtGamepadLegacyQtRoot Condition="'$(QTDIR)' != ''">$(QTDIR)</QtGamepadLegacyQtRoot>
    <QtGamepadLegacyQtRoot Condition="'$(QtGamepadLegacyQtRoot)' == ''">C:\Qt\6.11.2\msvc2022_64</QtGamepadLegacyQtRoot>
    <QtGamepadLegacyLibrary Condition="'$(Configuration)' == 'Debug'">Qt6GamepadLegacyd.lib</QtGamepadLegacyLibrary>
    <QtGamepadLegacyLibrary Condition="'$(Configuration)' != 'Debug'">Qt6GamepadLegacy.lib</QtGamepadLegacyLibrary>
    <QtGamepadLegacyDll Condition="'$(Configuration)' == 'Debug'">Qt6GamepadLegacyd.dll</QtGamepadLegacyDll>
    <QtGamepadLegacyDll Condition="'$(Configuration)' != 'Debug'">Qt6GamepadLegacy.dll</QtGamepadLegacyDll>
    <QtGamepadLegacyPlugin Condition="'$(Configuration)' == 'Debug'">xinputgamepadd.dll</QtGamepadLegacyPlugin>
    <QtGamepadLegacyPlugin Condition="'$(Configuration)' != 'Debug'">xinputgamepad.dll</QtGamepadLegacyPlugin>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(QtGamepadLegacyRoot)\include;$(QtGamepadLegacyRoot)\include\QtGamepadLegacy;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(QtGamepadLegacyRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(QtGamepadLegacyLibrary);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="BuildQtGamepadLegacy" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(QtGamepadLegacyRoot)\lib\$(QtGamepadLegacyLibrary)')">
    <Message Importance="High" Text="Building QtGamepadLegacy ($(Configuration)) because $(QtGamepadLegacyLibrary) is not installed." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(QtGamepadLegacyBuildScript)&quot; -Configuration $(Configuration) -QtRoot &quot;$(QtGamepadLegacyQtRoot)&quot;" />
  </Target>

  <Target Name="DeployQtGamepadLegacy" AfterTargets="Build"
          Condition="Exists('$(QtGamepadLegacyRoot)\bin\$(QtGamepadLegacyDll)')">
    <MakeDir Directories="$(OutDir)legacygamepads" />
    <Copy SourceFiles="$(QtGamepadLegacyRoot)\bin\$(QtGamepadLegacyDll)"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(QtGamepadLegacyRoot)\plugins\legacygamepads\$(QtGamepadLegacyPlugin)"
          DestinationFolder="$(OutDir)legacygamepads"
          SkipUnchangedFiles="true"
          Condition="Exists('$(QtGamepadLegacyRoot)\plugins\legacygamepads\$(QtGamepadLegacyPlugin)')" />
  </Target>
</Project>
