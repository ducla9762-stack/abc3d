# =========================

# I/O Testing Files (Keep)

# =========================

# The meshes suite in assets/models is read by name from tests/test_io.cpp and
# tests/test_mesh.cpp, so it has to be tracked even though the rules above ignore
# *.obj (which also catches compiled objects), *.stl and *.py. 

# Deliberately broken inputs, should reject
!assets/models/bad.obj
!assets/models/bad.stl
!assets/models/degen.obj
!assets/models/negidx.obj
!assets/models/oob.obj
!assets/models/trailing.stl
!assets/models/truncated.stl

# Signed-zero weld regression and generator (py file)
!assets/models/weld_signed_zero.stl
!assets/models/weld_signed_zero_control.stl
!assets/models/make_weld_fixtures.py 

# Known-good inputs (round-trip testing and load regularly)
!assets/models/Cube.stl
!assets/models/box.obj
!assets/models/dodecahedron.obj
!assets/models/ico_sphere.obj

# The 5M-poly stress models are ~1 GB together, so they stay out of the repo -> Maybe later for performance
assets/models/stress/

# vcpkg (clone locally, do not commit)
vcpkg/
