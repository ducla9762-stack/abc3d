{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug abc3d",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      // The app loads assets with paths like "../assets/shaders/Grid.vert", so the
      // working directory must sit exactly one level below the repo root.
      "cwd": "${workspaceFolder}/out",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/tests/${command:cmake.buildType}/abc3d_tests.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: build"
    }
  ]
}
