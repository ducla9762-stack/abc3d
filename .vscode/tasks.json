{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "targets": ["all"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"],
      "detail": "Build all targets with the active CMake preset"
    },
    {
      "type": "shell",
      "label": "CMake: test",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "dependsOn": "CMake: build",
      "detail": "Run the CTest suite"
    }
  ]
}
